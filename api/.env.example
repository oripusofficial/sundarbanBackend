PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/database-name
IMAGEKIT_ID=your_imagekit_id
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
